<Window
    x:Class="v2rayN.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:view="clr-namespace:v2rayN.Desktop.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="v2rayN"
    Width="1240"
    Height="800"
    MinWidth="900"
    MinHeight="600"
    x:DataType="vms:MainWindowViewModel"
    Design.DataContext="{x:Static dd:DesignData.MainWindow}"
    Icon="/Assets/NotifyIcon1.ico"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Styles>
        <!-- Keep the log selected; hide only the strip when it has no other tabs. -->
        <Style Selector="TabControl.logPane /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="IsVisible" Value="{Binding ShowClashUI}" />
        </Style>
        <Style Selector="TabControl.logPane /template/ Border#PART_BorderSeparator">
            <Setter Property="IsVisible" Value="{Binding ShowClashUI}" />
        </Style>

        <Style Selector="TextBlock.railLabel">
            <Setter Property="MaxWidth" Value="82" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="13.5" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Button.railNavBtn">
            <Setter Property="Width" Value="88" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="3,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
        </Style>
        <Style Selector="Button.railNavBtn.Accent">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Menu.railMenu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Spacing="2" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="Menu.railMenu > MenuItem">
            <Setter Property="Width" Value="88" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="3,6" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Menu.railMenu > MenuItem /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Menu.railMenu > MenuItem /template/ Popup#PART_Popup">
            <Setter Property="Placement" Value="RightEdgeAlignedTop" />
            <Setter Property="HorizontalOffset" Value="6" />
        </Style>
        <Style Selector="Menu.railMenu.bottomMenu > MenuItem /template/ Popup#PART_Popup">
            <Setter Property="Placement" Value="RightEdgeAlignedBottom" />
            <Setter Property="HorizontalOffset" Value="6" />
        </Style>
    </Window.Styles>

    <dialogHost:DialogHost CloseOnClickAway="True" DisableOpeningAnimation="True">
        <Grid ColumnDefinitions="96,*">
            <!-- Col 0: Left Navigation Rail (由左向右第 1 级全局导航轨) -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource SemiColorBg1}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <!-- Brand Header -->
                    <StackPanel
                        Margin="0,10,0,6"
                        HorizontalAlignment="Center"
                        DockPanel.Dock="Top"
                        Spacing="3">
                        <Image
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Center"
                            Source="/v2rayN.png" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.88"
                            Text="v2rayN" />
                    </StackPanel>

                    <!-- Bottom System Controls -->
                    <StackPanel
                        Margin="0,2,0,6"
                        HorizontalAlignment="Center"
                        DockPanel.Dock="Bottom"
                        Spacing="1">
                        <Button
                            x:Name="btnNewUpdate"
                            Width="88"
                            MinHeight="28"
                            Margin="0,0,0,3"
                            Padding="4,3"
                            HorizontalContentAlignment="Center"
                            Classes="Success"
                            IsVisible="False"
                            ToolTip.Tip="{x:Static resx:ResUI.menuNewUpdate}">
                            <TextBlock
                                MaxWidth="78"
                                FontSize="11"
                                LineHeight="13"
                                Text="{x:Static resx:ResUI.menuNewUpdate}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </Button>

                        <Separator Width="60" Margin="0,3" />

                        <ContentControl x:Name="conTheme" HorizontalAlignment="Center" />

                        <Menu Classes="railMenu bottomMenu">
                            <MenuItem
                                x:Name="menuHelp"
                                AutomationProperties.Name="{x:Static resx:ResUI.menuHelp}"
                                ToolTip.Tip="{x:Static resx:ResUI.menuHelp}">
                                <MenuItem.Header>
                                    <StackPanel HorizontalAlignment="Center" Spacing="3">
                                        <PathIcon
                                            Width="17"
                                            Height="17"
                                            HorizontalAlignment="Center"
                                            Data="{StaticResource nav_help}" />
                                        <TextBlock
                                            Classes="railLabel"
                                            Text="{x:Static resx:ResUI.menuHelp}" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem x:Name="menuCheckUpdate" Header="{x:Static resx:ResUI.menuCheckUpdate}" />
                                <Separator />
                            </MenuItem>
                        </Menu>

                        <Button
                            x:Name="menuReload"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuReload}"
                            Classes="railNavBtn"
                            ToolTip.Tip="{x:Static resx:ResUI.menuReload}">
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <PathIcon
                                    Width="17"
                                    Height="17"
                                    HorizontalAlignment="Center"
                                    Data="{StaticResource building_refresh}" />
                                <TextBlock
                                    Classes="railLabel"
                                    Text="{x:Static resx:ResUI.menuReload}" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="menuPromotion"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuPromotion}"
                            Classes="railNavBtn"
                            ToolTip.Tip="{x:Static resx:ResUI.menuPromotion}">
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <PathIcon
                                    Width="17"
                                    Height="17"
                                    HorizontalAlignment="Center"
                                    Data="{StaticResource nav_promo}" />
                                <TextBlock
                                    Classes="railLabel"
                                    Text="{x:Static resx:ResUI.menuPromotion}" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="menuClose"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuExit}"
                            Classes="railNavBtn"
                            ToolTip.Tip="{x:Static resx:ResUI.menuExit}">
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <PathIcon
                                    Width="17"
                                    Height="17"
                                    HorizontalAlignment="Center"
                                    Data="{StaticResource nav_close}" />
                                <TextBlock
                                    Classes="railLabel"
                                    Text="{x:Static resx:ResUI.menuExit}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Primary Navigation & Global Menus -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                        <StackPanel HorizontalAlignment="Center">
                            <Button
                                x:Name="btnHome"
                                AutomationProperties.Name="首页"
                                Classes="railNavBtn Accent"
                                ToolTip.Tip="首页">
                                <StackPanel HorizontalAlignment="Center" Spacing="3">
                                    <PathIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        Data="{StaticResource nav_home}" />
                                    <TextBlock Classes="railLabel" Text="首页" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="btnProxy"
                                AutomationProperties.Name="代理"
                                Classes="railNavBtn"
                                ToolTip.Tip="代理">
                                <StackPanel HorizontalAlignment="Center" Spacing="3">
                                    <PathIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        Data="{StaticResource nav_proxy}" />
                                    <TextBlock Classes="railLabel" Text="代理" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="btnClashProxies"
                                AutomationProperties.Name="{x:Static resx:ResUI.TbProxies}"
                                Classes="railNavBtn"
                                IsVisible="False"
                                ToolTip.Tip="{x:Static resx:ResUI.TbProxies}">
                                <StackPanel HorizontalAlignment="Center" Spacing="3">
                                    <PathIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        Data="{StaticResource nav_proxies}" />
                                    <TextBlock
                                        Classes="railLabel"
                                        Text="{x:Static resx:ResUI.TbProxies}" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="btnClashConnections"
                                AutomationProperties.Name="{x:Static resx:ResUI.TbConnections}"
                                Classes="railNavBtn"
                                IsVisible="False"
                                ToolTip.Tip="{x:Static resx:ResUI.TbConnections}">
                                <StackPanel HorizontalAlignment="Center" Spacing="3">
                                    <PathIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        Data="{StaticResource nav_connections}" />
                                    <TextBlock
                                        Classes="railLabel"
                                        Text="{x:Static resx:ResUI.TbConnections}" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="btnLogs"
                                AutomationProperties.Name="{x:Static resx:ResUI.MsgInformationTitle}"
                                Classes="railNavBtn"
                                ToolTip.Tip="{x:Static resx:ResUI.MsgInformationTitle}">
                                <StackPanel HorizontalAlignment="Center" Spacing="3">
                                    <PathIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        Data="{StaticResource nav_logs}" />
                                    <TextBlock
                                        Classes="railLabel"
                                        Text="{x:Static resx:ResUI.MsgInformationTitle}" />
                                </StackPanel>
                            </Button>

                            <Separator Width="60" Margin="0,6" />

                            <Menu Classes="railMenu">
                                <MenuItem
                                    AutomationProperties.Name="{x:Static resx:ResUI.menuServers}"
                                    ToolTip.Tip="{x:Static resx:ResUI.menuServers}">
                                    <MenuItem.Header>
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <PathIcon
                                                Width="17"
                                                Height="17"
                                                HorizontalAlignment="Center"
                                                Data="{StaticResource nav_servers}" />
                                            <TextBlock
                                                Classes="railLabel"
                                                Text="{x:Static resx:ResUI.menuServers}" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem
                                        x:Name="menuAddServerViaClipboard"
                                        Header="{x:Static resx:ResUI.menuAddServerViaClipboard}"
                                        InputGesture="Ctrl+V" />
                                    <MenuItem
                                        x:Name="menuAddServerViaScan"
                                        Header="{x:Static resx:ResUI.menuAddServerViaScan}"
                                        InputGesture="Ctrl+S" />
                                    <MenuItem x:Name="menuAddServerViaImage" Header="{x:Static resx:ResUI.menuAddServerViaImage}" />
                                    <Separator />
                                    <MenuItem x:Name="menuAddCustomServer" Header="{x:Static resx:ResUI.menuAddCustomServer}" />
                                    <MenuItem x:Name="menuAddPolicyGroupServer" Header="{x:Static resx:ResUI.menuAddPolicyGroupServer}" />
                                    <MenuItem x:Name="menuAddProxyChainServer" Header="{x:Static resx:ResUI.menuAddProxyChainServer}" />
                                    <MenuItem x:Name="menuAddCustomOutboundServer" Header="{x:Static resx:ResUI.menuAddCustomOutboundServer}" />
                                    <Separator />
                                    <MenuItem x:Name="menuAddVmessServer" Header="{x:Static resx:ResUI.menuAddVmessServer}" />
                                    <MenuItem x:Name="menuAddVlessServer" Header="{x:Static resx:ResUI.menuAddVlessServer}" />
                                    <MenuItem x:Name="menuAddShadowsocksServer" Header="{x:Static resx:ResUI.menuAddShadowsocksServer}" />
                                    <MenuItem x:Name="menuAddTrojanServer" Header="{x:Static resx:ResUI.menuAddTrojanServer}" />
                                    <MenuItem x:Name="menuAddHysteria2Server" Header="{x:Static resx:ResUI.menuAddHysteria2Server}" />
                                    <MenuItem x:Name="menuAddWireguardServer" Header="{x:Static resx:ResUI.menuAddWireguardServer}" />
                                    <MenuItem x:Name="menuAddMasqueServer" Header="{x:Static resx:ResUI.menuAddMasqueServer}" />
                                    <MenuItem x:Name="menuAddSocksServer" Header="{x:Static resx:ResUI.menuAddSocksServer}" />
                                    <MenuItem x:Name="menuAddHttpServer" Header="{x:Static resx:ResUI.menuAddHttpServer}" />
                                    <Separator />
                                    <MenuItem x:Name="menuAddTuicServer" Header="{x:Static resx:ResUI.menuAddTuicServer}" />
                                    <MenuItem x:Name="menuAddAnytlsServer" Header="{x:Static resx:ResUI.menuAddAnytlsServer}" />
                                    <MenuItem x:Name="menuAddNaiveServer" Header="{x:Static resx:ResUI.menuAddNaiveServer}" />
                                </MenuItem>

                                <MenuItem
                                    AutomationProperties.Name="{x:Static resx:ResUI.menuSubscription}"
                                    ToolTip.Tip="{x:Static resx:ResUI.menuSubscription}">
                                    <MenuItem.Header>
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <PathIcon
                                                Width="17"
                                                Height="17"
                                                HorizontalAlignment="Center"
                                                Data="{StaticResource nav_sub}" />
                                            <TextBlock
                                                Classes="railLabel"
                                                Text="{x:Static resx:ResUI.menuSubscription}" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem x:Name="menuSubSetting" Header="{x:Static resx:ResUI.menuSubSetting}" />
                                    <Separator />
                                    <MenuItem x:Name="menuSubUpdate" Header="{x:Static resx:ResUI.menuSubUpdate}" />
                                    <MenuItem x:Name="menuSubUpdateViaProxy" Header="{x:Static resx:ResUI.menuSubUpdateViaProxy}" />
                                    <MenuItem x:Name="menuSubGroupUpdate" Header="{x:Static resx:ResUI.menuSubGroupUpdate}" />
                                    <MenuItem x:Name="menuSubGroupUpdateViaProxy" Header="{x:Static resx:ResUI.menuSubGroupUpdateViaProxy}" />
                                </MenuItem>

                                <MenuItem
                                    AutomationProperties.Name="{x:Static resx:ResUI.menuSetting}"
                                    ToolTip.Tip="{x:Static resx:ResUI.menuSetting}">
                                    <MenuItem.Header>
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <PathIcon
                                                Width="17"
                                                Height="17"
                                                HorizontalAlignment="Center"
                                                Data="{StaticResource nav_settings}" />
                                            <TextBlock
                                                Classes="railLabel"
                                                Text="{x:Static resx:ResUI.menuSetting}" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem x:Name="menuOptionSetting" Header="{x:Static resx:ResUI.menuOptionSetting}" />
                                    <MenuItem x:Name="menuRoutingSetting" Header="{x:Static resx:ResUI.menuRoutingSetting}" />
                                    <MenuItem x:Name="menuDNSSetting" Header="{x:Static resx:ResUI.menuDNSSetting}" />
                                    <MenuItem x:Name="menuFullConfigTemplate" Header="{x:Static resx:ResUI.menuFullConfigTemplate}" />
                                    <MenuItem
                                        x:Name="menuGlobalHotkeySetting"
                                        Header="{x:Static resx:ResUI.menuGlobalHotkeySetting}"
                                        IsVisible="{Binding BlIsWindows}" />
                                    <Separator />
                                    <MenuItem
                                        x:Name="menuRebootAsAdmin"
                                        Header="{x:Static resx:ResUI.menuRebootAsAdmin}"
                                        IsVisible="{Binding BlIsWindows}" />
                                    <MenuItem
                                        x:Name="menuSettingsSetUWP"
                                        Header="{x:Static resx:ResUI.TbSettingsSetUWP}"
                                        IsVisible="{Binding BlIsWindows}" />
                                    <MenuItem x:Name="menuClearServerStatistics" Header="{x:Static resx:ResUI.menuClearServerStatistics}" />
                                    <Separator />
                                    <MenuItem Header="{x:Static resx:ResUI.menuRegionalPresets}">
                                        <MenuItem x:Name="menuRegionalPresetsDefault" Header="{x:Static resx:ResUI.menuRegionalPresetsDefault}" />
                                        <MenuItem x:Name="menuRegionalPresetsRussia" Header="{x:Static resx:ResUI.menuRegionalPresetsRussia}" />
                                        <MenuItem x:Name="menuRegionalPresetsIran" Header="{x:Static resx:ResUI.menuRegionalPresetsIran}" />
                                    </MenuItem>
                                    <MenuItem x:Name="menuBackupAndRestore" Header="{x:Static resx:ResUI.menuBackupAndRestore}" />
                                    <MenuItem x:Name="menuOpenTheFileLocation" Header="{x:Static resx:ResUI.menuOpenTheFileLocation}" />
                                </MenuItem>
                            </Menu>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Col 1: Right Main Content + Bottom Status Bar -->
            <DockPanel Grid.Column="1">
                <ContentControl x:Name="contentStatusBarView" DockPanel.Dock="Bottom" />

                <Grid>
                    <view:AnimatedGifImage
                        x:Name="workspaceBackgroundImage"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsHitTestVisible="False"
                        IsVisible="False"
                        Stretch="UniformToFill" />
                    <Border
                        x:Name="workspaceBackgroundOverlay"
                        Background="{DynamicResource SemiColorBg0}"
                        IsHitTestVisible="False"
                        Opacity="0" />

                    <!-- Home Workspace -->
                    <DockPanel x:Name="workspaceHome">
                        <Grid DockPanel.Dock="Top">
                            <Border
                                Background="{DynamicResource SemiColorBg1}"
                                BorderBrush="{DynamicResource SemiColorBorder}"
                                BorderThickness="0,0,0,1"
                                Opacity="0.88" />
                            <DockPanel Margin="20,10" LastChildFill="False">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Left"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="首页" />
                                <Button
                                    x:Name="btnAddSubscription"
                                    Height="32"
                                    MinWidth="96"
                                    Padding="12,0"
                                    AutomationProperties.Name="添加订阅"
                                    Classes="Success"
                                    Content="＋ 添加订阅"
                                    DockPanel.Dock="Right"
                                    ToolTip.Tip="添加订阅" />
                            </DockPanel>
                        </Grid>
                        <ContentControl x:Name="tabSubscriptionInfo" />
                    </DockPanel>

                    <!-- Proxy / Logs / Clash Workspaces -->
                    <Grid x:Name="workspaceProxy" IsVisible="False">
                        <Grid
                            x:Name="gridMain"
                            ColumnDefinitions="1*,10,1*"
                            IsVisible="False">
                            <ContentControl x:Name="tabProfiles" Grid.Column="0" />
                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
                            <TabControl
                                x:Name="tabMain"
                                Grid.Column="2"
                                Classes="logPane"
                                HorizontalContentAlignment="Left">
                                <TabItem x:Name="tabMsgView" Header="{x:Static resx:ResUI.MsgInformationTitle}" />
                                <TabItem x:Name="tabClashProxies" Header="{x:Static resx:ResUI.TbProxies}" />
                                <TabItem x:Name="tabClashConnections" Header="{x:Static resx:ResUI.TbConnections}" />
                            </TabControl>
                        </Grid>

                        <Grid
                            x:Name="gridMain1"
                            IsVisible="False"
                            RowDefinitions="1*,10,1*">
                            <ContentControl x:Name="tabProfiles1" Grid.Row="0" />
                            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
                            <TabControl
                                x:Name="tabMain1"
                                Grid.Row="2"
                                Classes="logPane"
                                TabStripPlacement="Left">
                                <TabItem x:Name="tabMsgView1" Header="{x:Static resx:ResUI.MsgInformationTitle}" />
                                <TabItem x:Name="tabClashProxies1" Header="{x:Static resx:ResUI.TbProxies}" />
                                <TabItem x:Name="tabClashConnections1" Header="{x:Static resx:ResUI.TbConnections}" />
                            </TabControl>
                        </Grid>

                        <!-- Default Left-to-Right Full-Height Workspace Panels switched from Left Rail -->
                        <Grid x:Name="gridMain2" IsVisible="False">
                            <ContentControl x:Name="tabProfiles2" />
                            <ContentControl x:Name="tabMsgView2" IsVisible="False" />
                            <ContentControl x:Name="tabClashProxies2" IsVisible="False" />
                            <ContentControl x:Name="tabClashConnections2" IsVisible="False" />
                        </Grid>
                    </Grid>
                </Grid>
            </DockPanel>
        </Grid>
    </dialogHost:DialogHost>
</Window>
