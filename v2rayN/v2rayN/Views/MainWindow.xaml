<base:WindowBase
    x:Class="v2rayN.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:view="clr-namespace:v2rayN.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="v2rayN"
    Width="1240"
    Height="800"
    MinWidth="920"
    MinHeight="600"
    x:TypeArguments="vms:MainWindowViewModel"
    Icon="/Resources/v2rayN.ico"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="True"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Popupbox.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="WorkspaceRailLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="MaxWidth" Value="82" />
                <Setter Property="Margin" Value="0,3,0,0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="LineHeight" Value="13.5" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="WorkspaceRailButton" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="88" />
                <Setter Property="MinHeight" Value="46" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Padding" Value="3,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid Background="Transparent" SnapsToDevicePixels="True">
                                <Border
                                    x:Name="CardBg"
                                    Background="{DynamicResource MaterialDesignDivider}"
                                    CornerRadius="8"
                                    Opacity="0" />
                                <Border
                                    x:Name="ActiveIndicator"
                                    Width="3.5"
                                    Height="20"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                    CornerRadius="1.75"
                                    Visibility="Collapsed" />
                                <ContentPresenter
                                    x:Name="ContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="0.78" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBg" Property="Opacity" Value="0.55" />
                                    <Setter TargetName="ContentHost" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="Tag" Value="Active">
                                    <Setter TargetName="CardBg" Property="Opacity" Value="0.9" />
                                    <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ContentHost" Property="Opacity" Value="1" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="WorkspaceRailPopupBox"
                BasedOn="{StaticResource MaterialDesignToolForegroundPopupBox}"
                TargetType="{x:Type materialDesign:PopupBox}">
                <Setter Property="Width" Value="88" />
                <Setter Property="MinHeight" Value="46" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Padding" Value="3,6" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="PopupHorizontalOffset" Value="6" />
                <Setter Property="PopupUniformCornerRadius" Value="4" />
                <Setter Property="Opacity" Value="0.78" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </Trigger>
                    <Trigger Property="IsPopupOpen" Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style
                x:Key="RailToolbarMenu"
                BasedOn="{StaticResource ToolbarMenu}"
                TargetType="{x:Type Menu}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="WorkspaceRailTopMenuItem"
                BasedOn="{StaticResource MaterialDesignMenuItem}"
                TargetType="{x:Type MenuItem}">
                <Setter Property="Width" Value="88" />
                <Setter Property="MinHeight" Value="46" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Padding" Value="3,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Grid Background="Transparent" SnapsToDevicePixels="True">
                                <Border
                                    x:Name="CardBg"
                                    Background="{DynamicResource MaterialDesignDivider}"
                                    CornerRadius="8"
                                    Opacity="0" />
                                <ContentPresenter
                                    x:Name="HeaderPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    Opacity="0.78"
                                    RecognizesAccessKey="True"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <Popup
                                    x:Name="PART_Popup"
                                    AllowsTransparency="True"
                                    Focusable="False"
                                    HorizontalOffset="6"
                                    IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                    Placement="Right"
                                    PopupAnimation="Slide"
                                    VerticalOffset="0">
                                    <Border
                                        x:Name="SubMenuBorder"
                                        Margin="5"
                                        Background="{DynamicResource MaterialDesign.Brush.Background}"
                                        CornerRadius="4"
                                        Effect="{DynamicResource MaterialDesignShadowDepth2}">
                                        <ScrollViewer
                                            x:Name="SubMenuScrollViewer"
                                            MaxHeight="680"
                                            Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type FrameworkElement}, ResourceId=MenuScrollViewer}}"
                                            materialDesign:ScrollViewerAssist.IgnorePadding="True"
                                            materialDesign:ScrollViewerAssist.PaddingMode="Content">
                                            <Grid Margin="0,8" RenderOptions.ClearTypeHint="Enabled">
                                                <ItemsPresenter
                                                    x:Name="ItemsPresenter"
                                                    Grid.IsSharedSizeScope="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"
                                                    KeyboardNavigation.TabNavigation="Cycle"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="CardBg" Property="Opacity" Value="0.55" />
                                    <Setter TargetName="HeaderPresenter" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBg" Property="Opacity" Value="0.55" />
                                    <Setter TargetName="HeaderPresenter" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsSubmenuOpen" Value="True">
                                    <Setter TargetName="CardBg" Property="Opacity" Value="0.9" />
                                    <Setter TargetName="HeaderPresenter" Property="Opacity" Value="1" />
                                    <Setter TargetName="HeaderPresenter" Property="TextElement.FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:DialogHost
        materialDesign:TransitionAssist.DisableTransitions="True"
        CloseOnClickAway="True"
        Identifier="RootDialog"
        SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Col 0: Left Navigation Rail (由左向右第 1 级全局导航轨) -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <!-- Brand Header -->
                    <StackPanel
                        Margin="0,10,0,6"
                        HorizontalAlignment="Center"
                        DockPanel.Dock="Top">
                        <Image
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Center"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="/Resources/v2rayN.ico" />
                        <TextBlock
                            Margin="0,3,0,0"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.88"
                            Text="v2rayN" />
                    </StackPanel>

                    <!-- Bottom System Controls -->
                    <StackPanel
                        Margin="0,2,0,6"
                        HorizontalAlignment="Center"
                        DockPanel.Dock="Bottom">
                        <Button
                            x:Name="btnNewUpdate"
                            Width="88"
                            MinHeight="28"
                            Margin="0,0,0,3"
                            Padding="4,3"
                            Style="{StaticResource DefButton}"
                            ToolTip="{x:Static resx:ResUI.menuNewUpdate}"
                            Visibility="Collapsed">
                            <TextBlock
                                MaxWidth="78"
                                FontSize="11"
                                LineHeight="13"
                                Text="{x:Static resx:ResUI.menuNewUpdate}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </Button>

                        <Separator Width="60" Margin="0,3" />

                        <materialDesign:PopupBox
                            x:Name="popupAppearance"
                            PlacementMode="RightAndAlignBottomEdges"
                            StaysOpen="True"
                            Style="{StaticResource WorkspaceRailPopupBox}"
                            ToolTip="外观">
                            <materialDesign:PopupBox.ToggleContent>
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        Kind="PaletteOutline" />
                                    <TextBlock Style="{StaticResource WorkspaceRailLabel}" Text="外观" />
                                </StackPanel>
                            </materialDesign:PopupBox.ToggleContent>
                            <ContentControl x:Name="pbTheme" />
                        </materialDesign:PopupBox>

                        <Menu Style="{StaticResource RailToolbarMenu}">
                            <MenuItem
                                x:Name="menuHelp"
                                AutomationProperties.Name="{x:Static resx:ResUI.menuHelp}"
                                Style="{StaticResource WorkspaceRailTopMenuItem}"
                                ToolTip="{x:Static resx:ResUI.menuHelp}">
                                <MenuItem.Header>
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            Kind="HelpCircleOutline" />
                                        <TextBlock
                                            Style="{StaticResource WorkspaceRailLabel}"
                                            Text="{x:Static resx:ResUI.menuHelp}" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem x:Name="menuCheckUpdate" Header="{x:Static resx:ResUI.menuCheckUpdate}" />
                                <Separator Margin="-40,5" />
                            </MenuItem>
                        </Menu>

                        <Button
                            x:Name="menuReload"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuReload}"
                            Style="{StaticResource WorkspaceRailButton}"
                            ToolTip="{x:Static resx:ResUI.menuReload}">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    Kind="Reload" />
                                <TextBlock
                                    Style="{StaticResource WorkspaceRailLabel}"
                                    Text="{x:Static resx:ResUI.menuReload}" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="menuPromotion"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuPromotion}"
                            Style="{StaticResource WorkspaceRailButton}"
                            ToolTip="{x:Static resx:ResUI.menuPromotion}">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    Kind="VolumeHigh" />
                                <TextBlock
                                    Style="{StaticResource WorkspaceRailLabel}"
                                    Text="{x:Static resx:ResUI.menuPromotion}" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="menuClose"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuClose}"
                            Style="{StaticResource WorkspaceRailButton}"
                            ToolTip="{x:Static resx:ResUI.menuClose}">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    Kind="Minimize" />
                                <TextBlock
                                    Style="{StaticResource WorkspaceRailLabel}"
                                    Text="{x:Static resx:ResUI.menuClose}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Primary Navigation & Global Menus -->
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Hidden">
                        <StackPanel HorizontalAlignment="Center">
                            <Button
                                x:Name="btnHome"
                                AutomationProperties.Name="首页"
                                Style="{StaticResource WorkspaceRailButton}"
                                Tag="Active"
                                ToolTip="首页">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        Kind="HomeOutline" />
                                    <TextBlock Style="{StaticResource WorkspaceRailLabel}" Text="首页" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="btnProxy"
                                AutomationProperties.Name="代理"
                                Style="{StaticResource WorkspaceRailButton}"
                                ToolTip="代理">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        Kind="Earth" />
                                    <TextBlock Style="{StaticResource WorkspaceRailLabel}" Text="代理" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="btnClashProxies"
                                AutomationProperties.Name="{x:Static resx:ResUI.TbProxies}"
                                Style="{StaticResource WorkspaceRailButton}"
                                ToolTip="{x:Static resx:ResUI.TbProxies}"
                                Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        Kind="ArrowDecisionOutline" />
                                    <TextBlock
                                        Style="{StaticResource WorkspaceRailLabel}"
                                        Text="{x:Static resx:ResUI.TbProxies}" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="btnClashConnections"
                                AutomationProperties.Name="{x:Static resx:ResUI.TbConnections}"
                                Style="{StaticResource WorkspaceRailButton}"
                                ToolTip="{x:Static resx:ResUI.TbConnections}"
                                Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        Kind="LanConnect" />
                                    <TextBlock
                                        Style="{StaticResource WorkspaceRailLabel}"
                                        Text="{x:Static resx:ResUI.TbConnections}" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="btnLogs"
                                AutomationProperties.Name="{x:Static resx:ResUI.MsgInformationTitle}"
                                Style="{StaticResource WorkspaceRailButton}"
                                ToolTip="{x:Static resx:ResUI.MsgInformationTitle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        Kind="MessageTextOutline" />
                                    <TextBlock
                                        Style="{StaticResource WorkspaceRailLabel}"
                                        Text="{x:Static resx:ResUI.MsgInformationTitle}" />
                                </StackPanel>
                            </Button>

                            <Separator Width="60" Margin="0,4" />

                            <Menu Style="{StaticResource RailToolbarMenu}">
                                <MenuItem
                                    x:Name="menuServersTop"
                                    AutomationProperties.Name="{x:Static resx:ResUI.menuServers}"
                                    Style="{StaticResource WorkspaceRailTopMenuItem}"
                                    ToolTip="{x:Static resx:ResUI.menuServers}">
                                    <MenuItem.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                HorizontalAlignment="Center"
                                                Kind="Server" />
                                            <TextBlock
                                                Style="{StaticResource WorkspaceRailLabel}"
                                                Text="{x:Static resx:ResUI.menuServers}" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem
                                        x:Name="menuAddServerViaClipboard"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddServerViaClipboard}"
                                        InputGestureText="Ctrl+V" />
                                    <MenuItem
                                        x:Name="menuAddServerViaScan"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddServerViaScan}"
                                        InputGestureText="Ctrl+S" />
                                    <MenuItem
                                        x:Name="menuAddServerViaImage"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddServerViaImage}" />
                                    <Separator Margin="-40,5" />
                                    <MenuItem
                                        x:Name="menuAddCustomServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddCustomServer}" />
                                    <MenuItem
                                        x:Name="menuAddPolicyGroupServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddPolicyGroupServer}" />
                                    <MenuItem
                                        x:Name="menuAddProxyChainServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddProxyChainServer}" />
                                    <MenuItem
                                        x:Name="menuAddCustomOutboundServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddCustomOutboundServer}" />
                                    <Separator Margin="-40,5" />
                                    <MenuItem
                                        x:Name="menuAddVmessServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddVmessServer}" />
                                    <MenuItem
                                        x:Name="menuAddVlessServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddVlessServer}" />
                                    <MenuItem
                                        x:Name="menuAddShadowsocksServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddShadowsocksServer}" />
                                    <MenuItem
                                        x:Name="menuAddTrojanServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddTrojanServer}" />
                                    <MenuItem
                                        x:Name="menuAddHysteria2Server"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddHysteria2Server}" />
                                    <MenuItem
                                        x:Name="menuAddWireguardServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddWireguardServer}" />
                                    <MenuItem
                                        x:Name="menuAddMasqueServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddMasqueServer}" />
                                    <MenuItem
                                        x:Name="menuAddSocksServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddSocksServer}" />
                                    <MenuItem
                                        x:Name="menuAddHttpServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddHttpServer}" />
                                    <Separator Margin="-40,5" />
                                    <MenuItem
                                        x:Name="menuAddTuicServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddTuicServer}" />
                                    <MenuItem
                                        x:Name="menuAddAnytlsServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddAnytlsServer}" />
                                    <MenuItem
                                        x:Name="menuAddNaiveServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddNaiveServer}" />
                                </MenuItem>
                            </Menu>

                            <Menu Style="{StaticResource RailToolbarMenu}">
                                <MenuItem
                                    x:Name="menuSubscriptionTop"
                                    AutomationProperties.Name="{x:Static resx:ResUI.menuSubscription}"
                                    Style="{StaticResource WorkspaceRailTopMenuItem}"
                                    ToolTip="{x:Static resx:ResUI.menuSubscription}">
                                    <MenuItem.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                HorizontalAlignment="Center"
                                                Kind="BookClockOutline" />
                                            <TextBlock
                                                Style="{StaticResource WorkspaceRailLabel}"
                                                Text="{x:Static resx:ResUI.menuSubscription}" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem
                                        x:Name="menuSubSetting"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuSubSetting}" />
                                    <Separator Margin="-40,5" />
                                    <MenuItem
                                        x:Name="menuSubUpdate"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuSubUpdate}" />
                                    <MenuItem
                                        x:Name="menuSubUpdateViaProxy"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuSubUpdateViaProxy}" />
                                    <MenuItem
                                        x:Name="menuSubGroupUpdate"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuSubGroupUpdate}" />
                                    <MenuItem
                                        x:Name="menuSubGroupUpdateViaProxy"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuSubGroupUpdateViaProxy}" />
                                </MenuItem>
                            </Menu>

                            <Menu Style="{StaticResource RailToolbarMenu}">
                                <MenuItem
                                    x:Name="menuSettingTop"
                                    AutomationProperties.Name="{x:Static resx:ResUI.menuSetting}"
                                    Style="{StaticResource WorkspaceRailTopMenuItem}"
                                    ToolTip="{x:Static resx:ResUI.menuSetting}">
                                    <MenuItem.Header>
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                HorizontalAlignment="Center"
                                                Kind="SettingsOutline" />
                                            <TextBlock
                                                Style="{StaticResource WorkspaceRailLabel}"
                                                Text="{x:Static resx:ResUI.menuSetting}" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem
                                        x:Name="menuOptionSetting"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuOptionSetting}" />
                                    <MenuItem
                                        x:Name="menuRoutingSetting"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRoutingSetting}" />
                                    <MenuItem
                                        x:Name="menuDNSSetting"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuDNSSetting}" />
                                    <MenuItem
                                        x:Name="menuFullConfigTemplate"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuFullConfigTemplate}" />
                                    <MenuItem
                                        x:Name="menuGlobalHotkeySetting"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuGlobalHotkeySetting}" />
                                    <Separator Margin="-40,5" />
                                    <MenuItem
                                        x:Name="menuRebootAsAdmin"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRebootAsAdmin}" />
                                    <MenuItem
                                        x:Name="menuSettingsSetUWP"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.TbSettingsSetUWP}" />
                                    <MenuItem
                                        x:Name="menuClearServerStatistics"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuClearServerStatistics}" />
                                    <Separator Margin="-40,5" />
                                    <MenuItem Height="{StaticResource MenuItemHeight}" Header="{x:Static resx:ResUI.menuRegionalPresets}">
                                        <MenuItem
                                            x:Name="menuRegionalPresetsDefault"
                                            Height="{StaticResource MenuItemHeight}"
                                            Header="{x:Static resx:ResUI.menuRegionalPresetsDefault}" />
                                        <MenuItem
                                            x:Name="menuRegionalPresetsRussia"
                                            Height="{StaticResource MenuItemHeight}"
                                            Header="{x:Static resx:ResUI.menuRegionalPresetsRussia}" />
                                        <MenuItem
                                            x:Name="menuRegionalPresetsIran"
                                            Height="{StaticResource MenuItemHeight}"
                                            Header="{x:Static resx:ResUI.menuRegionalPresetsIran}" />
                                    </MenuItem>
                                    <MenuItem
                                        x:Name="menuBackupAndRestore"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuBackupAndRestore}" />
                                    <MenuItem
                                        x:Name="menuOpenTheFileLocation"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuOpenTheFileLocation}" />
                                </MenuItem>
                            </Menu>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Col 1: Right Main Content + Bottom Status Bar -->
            <DockPanel Grid.Column="1">
                <ContentControl x:Name="contentStatusBarView" DockPanel.Dock="Bottom" />

                <Grid>
                    <Image
                        x:Name="workspaceBackgroundImage"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsHitTestVisible="False"
                        Stretch="UniformToFill"
                        Visibility="Collapsed" />
                    <Border
                        x:Name="workspaceBackgroundOverlay"
                        Background="{DynamicResource MaterialDesignPaper}"
                        IsHitTestVisible="False"
                        Opacity="0" />

                    <!-- Home Workspace -->
                    <DockPanel x:Name="workspaceHome">
                        <Grid DockPanel.Dock="Top">
                            <Border
                                Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="0,0,0,1"
                                Opacity="0.86" />
                            <DockPanel Margin="20,10" LastChildFill="False">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Left"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="首页" />
                                <Button
                                    x:Name="btnAddSubscription"
                                    Height="30"
                                    Padding="12,0"
                                    AutomationProperties.Name="添加订阅"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource DefButton}"
                                    ToolTip="添加订阅">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Kind="Plus" />
                                        <TextBlock VerticalAlignment="Center" Text="添加订阅" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                        </Grid>
                        <ContentControl x:Name="tabSubscriptionInfo1" />
                    </DockPanel>

                    <!-- Proxy / Logs / Clash Workspaces -->
                    <Grid x:Name="workspaceProxy" Visibility="Collapsed">
                        <Grid x:Name="gridMain" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <ContentControl x:Name="tabProfiles" Grid.Column="0" />
                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
                            <TabControl
                                x:Name="tabMain"
                                Grid.Column="2"
                                HorizontalContentAlignment="Left"
                                Background="Transparent">
                                <TabItem x:Name="tabMsgView" Header="{x:Static resx:ResUI.MsgInformationTitle}" />
                                <TabItem x:Name="tabClashProxies" Header="{x:Static resx:ResUI.TbProxies}" />
                                <TabItem x:Name="tabClashConnections" Header="{x:Static resx:ResUI.TbConnections}" />
                            </TabControl>
                        </Grid>

                        <Grid x:Name="gridMain1" Visibility="Collapsed">
                            <Grid x:Name="gridMainRight1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="1*" />
                                </Grid.RowDefinitions>
                                <ContentControl x:Name="tabProfiles1" Grid.Row="0" />
                                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
                                <TabControl
                                    x:Name="tabMain1"
                                    Grid.Row="2"
                                    materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
                                    Background="Transparent"
                                    Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                                    TabStripPlacement="Left">
                                    <TabItem x:Name="tabMsgView1">
                                        <TabItem.Header>
                                            <StackPanel>
                                                <materialDesign:PackIcon HorizontalAlignment="Center" Kind="MessageTextOutline" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource ToolbarTextBlock}"
                                                    Text="{x:Static resx:ResUI.MsgInformationTitle}" />
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                    <TabItem x:Name="tabClashProxies1">
                                        <TabItem.Header>
                                            <StackPanel>
                                                <materialDesign:PackIcon HorizontalAlignment="Center" Kind="ArrowDecisionOutline" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource ToolbarTextBlock}"
                                                    Text="{x:Static resx:ResUI.TbProxies}" />
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                    <TabItem x:Name="tabClashConnections1">
                                        <TabItem.Header>
                                            <StackPanel>
                                                <materialDesign:PackIcon HorizontalAlignment="Center" Kind="LanConnect" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource ToolbarTextBlock}"
                                                    Text="{x:Static resx:ResUI.TbConnections}" />
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Grid>

                        <!-- Default Left-to-Right Full-Height Workspace Panels switched from Left Rail -->
                        <Grid x:Name="gridMain2" Visibility="Collapsed">
                            <ContentControl x:Name="tabProfiles2" />
                            <ContentControl x:Name="tabMsgView2" Visibility="Collapsed" />
                            <ContentControl x:Name="tabClashProxies2" Visibility="Collapsed" />
                            <ContentControl x:Name="tabClashConnections2" Visibility="Collapsed" />
                        </Grid>
                    </Grid>

                    <materialDesign:Snackbar x:Name="MainSnackbar" MessageQueue="{materialDesign:MessageQueue}" />
                </Grid>
            </DockPanel>
        </Grid>
    </materialDesign:DialogHost>
</base:WindowBase>
